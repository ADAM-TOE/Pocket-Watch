# Local server config
PORT=4000

# Azure OpenAI — optional for Bucket 5 validated insights. Leave blank for local fallback.
# The key stays server-side only and is NEVER shipped to the browser.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_VERSION=2024-10-21

# Database path — leave blank locally. On Azure App Service set to persistent /home storage,
# e.g. /home/data/budget.db, so transactions survive restart and redeploy.
DATABASE_PATH=

# Built React client — leave blank to use the bundled server/public folder. The server serves
# this folder so one App Service instance hosts both the UI and the API.
CLIENT_DIST_PATH=

# Daily backup — Blob upload runs only when configured (Bucket 6, Phase B). Uses managed
# identity, so no account key is stored here. Leave blank for local-only snapshots.
BACKUP_BLOB_ACCOUNT=
BACKUP_BLOB_CONTAINER=
